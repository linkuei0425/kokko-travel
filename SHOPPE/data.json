<script>
        let allProducts = [];       
        let filteredProducts = [];  
        let currentPage = 1;        
        const itemsPerPage = 48;    

        // 共用的時間排序邏輯：處理跨日時間排在最後
        function compareTimeStrings(timeA, timeB) {
            const isTomorrowA = timeA.includes('(') || timeA.includes('/');
            const isTomorrowB = timeB.includes('(') || timeB.includes('/');
            
            if (isTomorrowA && !isTomorrowB) return 1;
            if (!isTomorrowA && isTomorrowB) return -1;
            
            if (timeA < timeB) return -1;
            if (timeA > timeB) return 1;
            return 0;
        }

        // 讀取資料
        async function fetchStaticData() {
            try {
                // 將抓取的檔案名稱改為 data.json (如果還是 data.json 請自行改回)
                const response = await fetch(`data.json?t=${new Date().getTime()}`);
                if (!response.ok) throw new Error('Data fetch failed');
                
                let rawData = await response.json();
                
                // 【精準過濾清單】針對台灣法規禁售/限制商品
                const excludeKeywords = [
                    // 1. 藥品類 (新增酸痛貼布相關字眼)
                    '感冒藥', '腸胃藥', '止痛藥', '退燒藥', '眼藥水', '藥膏', '指示藥', '成藥', '處方藥',
                    '減肥藥', '壯陽藥', '催情藥', '墮胎藥', '安眠藥', '避孕藥', '酸痛貼布', '痠痛貼布',

                    // 2. 醫療器材
                    '保險套', '隱形眼鏡', '美瞳', '驗孕', '排卵試紙', '快篩', '血壓計', '血糖機', 
                    '耳溫槍', '額溫槍', '體溫計', '衛生棉條', '月亮杯', '隱形眼鏡盒', '生理食鹽水',

                    // 3. 環境與動物用藥
                    '防蚊液', '防蚊噴霧', '防蚊貼', '防蚊掛片', '防蚊扣', '殺蟲劑', '除蚤', '滅鼠', 
                    '心絲蟲', '螞蟻藥', '蟑螂藥', '老鼠藥', '農藥', '動物用藥',

                    // 4. 菸酒類
                    '電子煙', '電子菸', '香菸', '菸草', '雪茄', '菸彈', '煙彈', '加熱菸', '水煙',
                    '啤酒', '威士忌', '高粱', '伏特加', '紅酒', '白酒', '葡萄酒', '烈酒', '香檳',

                    // 5. 武器與管制刀具
                    '手指虎', '彈簧刀', '蝴蝶刀', '警棍', '甩棍', '手銬', '十字弓', '鎮暴槍', '信號槍',

                    // 6. 毒品與妨害風化
                    '春藥', '迷姦', '乖乖水', '聽話水', '原味內衣', '原味內褲', '原味絲襪', 
                    '安非他命', '海洛因', '大麻花', '大麻葉', '大麻煙', 'K他命',

                    // 7. 仿冒品與其他違禁品
                    '高仿', 'A貨', '1:1訂製', '1:1復刻', '破解版', '遊戲外掛', '盜版', 
                    '活體動物', '活體寵物', '象牙', '犀牛角', '玳瑁', '彩券', '刮刮樂', '代開發票', '帳戶買賣'
                ];
                
                allProducts = rawData.filter(p => {
                    const pName = String(p.name || '');
                    const pTag = String(p.tag || '');
                    
                    // 只要「商品名稱」或「標籤」裡包含任何一個排除關鍵字，就把它過濾掉
                    const hasExcludedKeyword = excludeKeywords.some(keyword => 
                        pName.includes(keyword) || pTag.includes(keyword)
                    );
                    
                    return !hasExcludedKeyword; 
                });

                filteredProducts = allProducts; 
                
                populateTimeOptions();
                populateTagOptions();
                
                document.getElementById('loading').style.display = 'none';
                document.getElementById('stats').classList.remove('hidden');
                
                applyFilters(); 
            } catch (err) {
                console.error('取得資料失敗:', err);
                document.getElementById('loading').innerHTML = `
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-5xl mb-4"></i>
                    <p class="text-red-600 font-bold text-lg">系統更新中，請稍後重試</p>
                `;
            }
        }

        function populateTimeOptions() {
            const timeSelect = document.getElementById('timeFilter');
            const uniqueTimes = [...new Set(allProducts.map(p => String(p.time || '')))]
                .filter(t => t.trim() !== '')
                .sort(compareTimeStrings);
                
            uniqueTimes.forEach(time => {
                const option = document.createElement('option');
                option.value = time;
                option.textContent = time;
                timeSelect.appendChild(option);
            });
        }

        function populateTagOptions() {
            const tagSelect = document.getElementById('tagFilter');
            const uniqueTags = [...new Set(allProducts.map(p => String(p.tag || '')))].filter(t => t.trim() !== '').sort();
            uniqueTags.forEach(tag => {
                const option = document.createElement('option');
                option.value = tag;
                option.textContent = tag;
                tagSelect.appendChild(option);
            });
        }

        function getDiscountNumber(discountStr) {
            if (!discountStr) return 999; 
            const num = parseFloat(String(discountStr).replace('折', '').trim());
            return isNaN(num) ? 999 : num;
        }

        function applyFilters() {
            const keyword = document.getElementById('searchInput').value.toLowerCase();
            const selectedTime = document.getElementById('timeFilter').value;
            const selectedTag = document.getElementById('tagFilter').value; 
            const sortType = document.getElementById('sortFilter').value;

            filteredProducts = allProducts.filter(p => {
                const matchKeyword = p.name.toLowerCase().includes(keyword) || p.tag.toLowerCase().includes(keyword);
                const pTimeStr = String(p.time || '');
                const matchTime = selectedTime === "" || pTimeStr === selectedTime;
                const pTagStr = String(p.tag || '');
                const matchTag = selectedTag === "" || pTagStr === selectedTag;
                return matchKeyword && matchTime && matchTag;
            });

            filteredProducts.sort((a, b) => {
                if (sortType === 'default') {
                    const timeCompare = compareTimeStrings(String(a.time || ''), String(b.time || ''));
                    if (timeCompare !== 0) return timeCompare;
                    return getDiscountNumber(a.discount) - getDiscountNumber(b.discount);
                }
                
                if (sortType === 'discountAsc') return getDiscountNumber(a.discount) - getDiscountNumber(b.discount);
                if (sortType === 'priceAsc' || sortType === 'priceDesc') {
                    const priceA = parseFloat(String(a.price).replace(/,/g, '')) || 0;
                    const priceB = parseFloat(String(b.price).replace(/,/g, '')) || 0;
                    return sortType === 'priceAsc' ? priceA - priceB : priceB - priceA;
                }
                return 0;
            });

            currentPage = 1; 
            renderPage();
        }

        function renderPage() {
            const container = document.getElementById('product-list');
            const countLabel = document.getElementById('itemCount');
            const noResults = document.getElementById('no-results');
            const paginationContainer = document.getElementById('pagination');
            
            container.innerHTML = '';
            
            if (filteredProducts.length === 0) {
                countLabel.textContent = `共找到 0 項商品`;
                container.classList.add('hidden');
                paginationContainer.classList.add('hidden');
                noResults.classList.remove('hidden');
                noResults.classList.add('flex');
                return;
            }
            
            noResults.classList.add('hidden');
            noResults.classList.remove('flex');
            container.classList.remove('hidden');
            paginationContainer.classList.remove('hidden');
            paginationContainer.classList.add('flex');

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const currentItems = filteredProducts.slice(startIndex, endIndex);

            countLabel.textContent = `共 ${filteredProducts.length} 筆商品 (目前顯示第 ${startIndex + 1} - ${Math.min(endIndex, filteredProducts.length)} 筆)`;

            currentItems.forEach(product => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden flex flex-col fade-in border border-gray-200';
                card.innerHTML = `
                    <div class="p-5 flex-grow flex flex-col">
                        <div class="flex justify-between items-start mb-3 gap-2">
                            <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded font-bold whitespace-nowrap">${product.tag || '一般商品'}</span>
                            <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded whitespace-nowrap font-medium"><i class="fa-regular fa-clock"></i> ${product.time}</span>
                        </div>
                        <h3 class="text-gray-800 font-bold text-base mb-3 line-clamp-2 h-12 leading-snug" title="${product.name}">${product.name}</h3>
                        <div class="mt-auto pt-3 border-t border-gray-100 flex flex-col">
                            <p class="text-xs text-gray-400 line-through mb-1">原價 $${product.price}</p>
                            <p class="text-red-500 font-black text-xl leading-none">${product.discount}</p>
                        </div>
                    </div>
                    <a href="${product.url}" target="_blank" rel="noopener noreferrer" 
                       class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center font-bold py-3 transition-colors duration-200 flex items-center justify-center gap-2 group">
                        商品詳情 <i class="fa-solid fa-arrow-right-from-bracket group-hover:translate-x-1 transition-transform"></i>
                    </a>
                `;
                container.appendChild(card);
            });

            window.scrollTo({ top: 0, behavior: 'smooth' });
            renderPaginationControls();
        }

        function renderPaginationControls() {
            const container = document.getElementById('pagination');
            const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
            container.innerHTML = '';

            if (totalPages <= 1) return; 

            const prevBtn = document.createElement('button');
            prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
            prevBtn.className = `w-10 h-10 flex justify-center items-center rounded-lg font-medium transition-colors ${currentPage === 1 ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-white border border-gray-300 text-gray-700 hover:bg-blue-50 hover:text-blue-600 shadow-sm'}`;
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => { currentPage--; renderPage(); };
            container.appendChild(prevBtn);

            const selectWrapper = document.createElement('div');
            selectWrapper.className = 'relative flex items-center';
            
            const select = document.createElement('select');
            select.className = 'appearance-none bg-white border border-gray-300 text-gray-700 py-2 pl-4 pr-10 rounded-lg font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer shadow-sm hover:border-blue-400 transition-colors';
            
            for (let i = 1; i <= totalPages; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = `第 ${i} 頁 / 共 ${totalPages} 頁`;
                if (i === currentPage) option.selected = true;
                select.appendChild(option);
            }

            select.onchange = (e) => {
                currentPage = parseInt(e.target.value, 10);
                renderPage();
            };

            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-chevron-down absolute right-3 text-gray-500 pointer-events-none text-sm';
            
            selectWrapper.appendChild(select);
            selectWrapper.appendChild(icon);
            container.appendChild(selectWrapper);

            const nextBtn = document.createElement('button');
            nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
            nextBtn.className = `w-10 h-10 flex justify-center items-center rounded-lg font-medium transition-colors ${currentPage === totalPages ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-white border border-gray-300 text-gray-700 hover:bg-blue-50 hover:text-blue-600 shadow-sm'}`;
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.onclick = () => { currentPage++; renderPage(); };
            container.appendChild(nextBtn);
        }

        document.getElementById('searchInput').addEventListener('input', applyFilters);
        document.getElementById('timeFilter').addEventListener('change', applyFilters);
        document.getElementById('tagFilter').addEventListener('change', applyFilters);
        document.getElementById('sortFilter').addEventListener('change', applyFilters);

        window.addEventListener('DOMContentLoaded', fetchStaticData);
    </script>
